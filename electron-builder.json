{
  "appId": "moe.sorayama.genshin-team-advisor",
  "productName": "Genshin Team Advisor",
  "artifactName": "${name}-${version}-${arch}.${ext}",
  "directories": {
    "output": "release",
    "buildResources": "resources"
  },
  "files": [
    "dist/main/**/*",
    "dist/renderer/**/*",
    "node_modules/**/*",
    "package.json",
    "!dist-tools/**/*",
    "!scripts/**/*"
  ],
  "asarUnpack": [
    "node_modules/@anthropic-ai/claude-agent-sdk/**/*",
    "node_modules/@anthropic-ai/claude-agent-sdk-*/**/*"
  ],
  "extraResources": [
    {
      "from": "resources/scenarios",
      "to": "scenarios",
      "filter": ["**/*.json", "!v2/development-source/**/*", "!v2/development/**/*"]
    },
    {
      "from": "resources/credits.md",
      "to": "credits.md"
    },
    {
      "from": "docs",
      "to": "docs",
      "filter": ["privacy.md", "data-acquisition.md", "llm-provider.md", "troubleshooting.md"]
    },
    {
      "from": "LICENSE",
      "to": "LICENSE"
    }
  ],
  "mac": {
    "target": ["dmg", "zip"],
    "category": "public.app-category.utilities",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "x64ArchFiles": "Contents/Resources/app.asar.unpacked/node_modules/@anthropic-ai/claude-agent-sdk-darwin-*/claude"
  },
  "win": {
    "target": ["nsis"]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },
  "publish": [
    {
      "provider": "github",
      "owner": "SoraYama",
      "repo": "genshin-ai-group-team",
      "releaseType": "draft"
    }
  ]
}
