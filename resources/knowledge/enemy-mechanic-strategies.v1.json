          "id": "wave-reset-core",
          "slots": ["repeatable-rotation", "reapplicable-setup", "sustain-or-flex"]
        }
      ],
      "facts": [
        {
          "id": "mechanic-multi-wave-fact",
          "statement": "技能存在再次施放的冷却，元素爆发还依赖能量；多波次场景应保留能够在新一波重新施放关键效果并维持能量循环的队伍骨架。",
          "citationIds": ["kqm-mechanics-cooldowns", "kqm-mechanics-energy"]
        }
      ]
    },
