      "facts": [
        {
          "id": "mechanic-shield-breaking-fact",
          "statement": "敌方元素盾与元素护甲并非同一种防护；配队应先确认防护类型，再准备能稳定施加合适元素或对应破盾能力的槽位。",
          "citationIds": ["kqm-mechanics-enemy-shields"]
        }
      ]
    },
    {
