        }
      ],
      "facts": [
        {
          "id": "mechanic-grouping-value-fact",
          "statement": "许多范围攻击会随同时命中的敌人数获得更高的总伤害；敌人可被聚拢时，聚怪能力能提高范围技能的有效覆盖。",
          "citationIds": ["kqm-mechanics-aoe-scaling"]
        }
      ]
    },
