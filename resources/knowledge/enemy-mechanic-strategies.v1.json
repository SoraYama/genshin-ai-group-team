      ],
      "facts": [
        {
          "id": "mechanic-ungroupable-fact",
          "statement": "范围伤害的收益取决于实际同时命中的目标；不可聚怪时，不应把必须拉拢敌人才能成立的伤害覆盖当作确定收益。",
          "citationIds": ["kqm-mechanics-aoe-scaling"]
        }
      ]
    },
